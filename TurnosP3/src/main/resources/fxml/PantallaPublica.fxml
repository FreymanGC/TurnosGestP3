<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" prefWidth="1280" prefHeight="760" styleClass="pantalla"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.turnos.controlador.PantallaPublicaController">

    <!-- Hojas de estilo de esta vista: la común y la propia -->
    <stylesheets>
        <URL value="@../css/comun.css"/>
        <URL value="@../css/pantalla-publica.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="encabezado">
            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true">
                <Image url="@../img/logo.png"/>
            </ImageView>
            <VBox>
                <Label text="Sala de Espera" styleClass="titulo"/>
                <Label text="Sistema de Gestión de Turnos" styleClass="subtitulo"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblHora" text="00:00:00" styleClass="pantalla-hora"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="28">
            <padding>
                <Insets top="28" right="32" bottom="24" left="32"/>
            </padding>

            <VBox alignment="CENTER" spacing="18" styleClass="pantalla-tarjeta" HBox.hgrow="ALWAYS">
                <Label text="TURNO LLAMADO" styleClass="pantalla-rotulo"/>
                <Label fx:id="lblTurnoActual" text="---" styleClass="pantalla-turno"/>
                <Label fx:id="lblVentanilla" text="Ventanilla: -" styleClass="pantalla-ventanilla"/>
                <Label fx:id="lblAviso" text="" styleClass="mensaje-error" wrapText="true"/>
            </VBox>

            <VBox spacing="14" prefWidth="440" minWidth="400" styleClass="pantalla-tarjeta">
                <Label text="LLAMADOS RECIENTES" styleClass="pantalla-rotulo"/>
                <ListView fx:id="lstHistorial" VBox.vgrow="ALWAYS" focusTraversable="false"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" styleClass="aviso-pie">
            <Label text="Por favor esté atento a la pantalla · Diríjase a la ventanilla indicada al escuchar el aviso"/>
        </HBox>
    </bottom>
</BorderPane>
