<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz" prefWidth="950" prefHeight="620"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.turnos.controlador.OperadorController">

    <fx:include fx:id="login" source="Login.fxml"/>

    <VBox fx:id="panelVentanilla" alignment="CENTER" spacing="14" maxWidth="420" maxHeight="380"
          visible="false" managed="false">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        <Label fx:id="lblBienvenida" text="" styleClass="titulo" wrapText="true"/>
        <Label text="Seleccione su ventanilla" styleClass="subtitulo"/>
        <ComboBox fx:id="cmbVentanilla" maxWidth="Infinity"/>
        <Label fx:id="lblErrorVentanilla" text="" styleClass="mensaje-error" wrapText="true"/>
        <Button fx:id="btnContinuar" text="Continuar" styleClass="boton-principal" onAction="#confirmarVentanilla" maxWidth="Infinity"/>
    </VBox>

    <BorderPane fx:id="panelOperador" visible="false" managed="false">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="panel">
                <padding>
                    <Insets top="15" right="25" bottom="15" left="25"/>
                </padding>
                <Label fx:id="lblFuncionario" text="Funcionario: -" styleClass="subtitulo"/>
                <Label fx:id="lblVentanilla" text="Ventanilla: -" styleClass="subtitulo"/>
                <Label fx:id="lblEstadoVentanilla" text="Estado: -" styleClass="subtitulo"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Cerrar sesión" styleClass="boton-secundario" onAction="#cerrarSesion"/>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="15" styleClass="panel">
                <Label text="Turno en curso" styleClass="subtitulo"/>
                <Label fx:id="lblTurnoActual" text="---" styleClass="turno-actual"/>
                <Label fx:id="lblEstadoTurno" text="Sin turno asignado" styleClass="subtitulo"/>

                <HBox fx:id="boxAcciones" alignment="CENTER" spacing="12">
                    <Button fx:id="btnSiguiente" text="Siguiente turno" styleClass="boton-principal" onAction="#solicitarSiguienteTurno"/>
                    <Button fx:id="btnVolverALlamar" text="Volver a llamar" styleClass="boton-secundario" onAction="#volverALlamar"/>
                    <Button fx:id="btnIniciar" text="Iniciar atención" styleClass="boton-secundario" onAction="#iniciarAtencion"/>
                    <Button fx:id="btnFinalizar" text="Finalizar atención" styleClass="boton-secundario" onAction="#finalizarAtencion"/>
                    <Button fx:id="btnDisponibilidad" text="Marcar no disponible" styleClass="boton-secundario" onAction="#alternarDisponibilidad"/>
                </HBox>

                <Label fx:id="lblMensaje" text="" styleClass="mensaje-error" wrapText="true"/>
            </VBox>
        </center>

        <bottom>
            <VBox spacing="8" styleClass="panel">
                <padding>
                    <Insets top="15" right="25" bottom="15" left="25"/>
                </padding>
                <Label text="Historial de hoy en esta ventanilla" styleClass="subtitulo"/>
                <ListView fx:id="lstHistorial" styleClass="lista-historial" prefHeight="150"/>
            </VBox>
        </bottom>
    </BorderPane>

</StackPane>
