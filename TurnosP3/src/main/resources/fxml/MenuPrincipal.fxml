<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.turnos.controlador.MenuPrincipalController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <Label styleClass="titulo" text="Sistema de Gestión de Turnos" />

    <Button maxWidth="Infinity" onAction="#abrirPantallaPublica" styleClass="boton-principal" text="Abrir Pantalla Pública" />
    <Button maxWidth="Infinity" onAction="#abrirGeneradoraTurnos" styleClass="boton-principal" text="Abrir Generadora de Turnos" />
    <Button maxWidth="Infinity" onAction="#abrirOperador" styleClass="boton-principal" text="Abrir Operador (Login + Atención)" />
    <Button maxWidth="Infinity" onAction="#abrirAdministrador" styleClass="boton-principal" text="Abrir Administración" />
</VBox>
